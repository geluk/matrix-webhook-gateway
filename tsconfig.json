{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    // Allows line number references from logging code.
    "sourceMap": true,
    "outDir": "out/webhook-gateway",
    "strictNullChecks": true,
    "types": ["node", "jest"],
    "plugins": [
      {
        "transform": "typia/lib/transform"
      }
    ]
  },
  "exclude": [
    "plugins",
    "jest.config.ts",
    "knexfile.ts",
    "**/*.test.ts"
  ]
}
